# ── Telegram Bot ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Google Gemini AI ───────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Pexels API (Free Stock Footage) ───────────────────────
# Get your FREE key at: https://www.pexels.com/api/
# Without this key, the bot uses gradient color backgrounds
PEXELS_API_KEY=your_pexels_api_key_here

# ── YouTube OAuth ──────────────────────────────────────────
# (Leave default - uses localhost redirect for manual auth)
# REDIRECT_URI=http://localhost

# ── ২ GB আপলোড (লোকাল Bot API সার্ভার) ─────────────────────
# https://my.telegram.org/apps → API development tools → Create app (Platform: Bot / Server)
# বসানোর সহজ উপায়:  ./tools/local_bot_api.sh setup
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# (ঐচ্ছিক) সার্ভারের পোর্ট
# TGBOT_API_PORT=8081

# ── আউটপুট ফরম্যাট ────────────────────────────────────────
# সব ভিডিও ১:১ (১০৮০×১০৮০) স্কয়ার
FORCE_SQUARE=1
# শিল্পীর নিজের কণ্ঠ অটুট (পিচ শিফট বন্ধ); ০ দিলে পুরোনো AI-ভয়েস
VOICE_ORIGINAL=1
# AI কমেন্ট্রি (ডিফল্ট বন্ধ)
AI_NARRATION=0
# BGM ভলিউম (কণ্ঠ স্পষ্ট রাখতে কম)
BGM_VOL=0.15

# ── BGM ───────────────────────────────────────────────────
# নিজের গান রাখো: assets/audio/own/   (mp3/wav/m4a)
# own | cc0 | mix
BGM_POOL=own
